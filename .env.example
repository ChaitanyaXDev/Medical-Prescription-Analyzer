# ============================================================
#  MedScript Analyzer - Environment Variables
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to Git!
# ============================================================

# ── Required: Primary AI Provider ───────────────────────────
# Google Gemini API key (get one free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Secondary AI Provider ─────────────────────────
# NVIDIA NIM API key (get one at https://developer.nvidia.com/nim)
# If set AND starts with "nvapi-", it takes priority over GEMINI_API_KEY.
NVIDIA_API_KEY=

# ── Optional: Azure AI Vision (OCR enhancement) ─────────────
# Enables Microsoft Azure Computer Vision Read API as an OCR pre-processing step.
# When configured, Azure extracts raw text first; then Gemini/NVIDIA uses both
# the image and the extracted text for a more accurate structured analysis.
#
# How to get Azure credentials:
#   1. Create a free Azure account: https://azure.microsoft.com/free/
#   2. Create an "Azure AI Services" or "Computer Vision" resource in the Azure Portal
#   3. Copy the Endpoint and Key from "Keys and Endpoint" section
#
# Azure endpoint format: https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_CV_ENDPOINT=
AZURE_CV_KEY=
